rules_version = '2';

// SheQueen — Firebase Storage security rules
// Product images: public read, admin-only write (max 5MB, images only)

service firebase.storage {
  match /b/{bucket}/o {

    // Admin = signed-in user with role "admin" in Firestore users/{uid}
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isProviderOwner(providerId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.providerId == providerId
        && firestore.exists(/databases/(default)/documents/serviceProviders/$(providerId))
        && firestore.get(/databases/(default)/documents/serviceProviders/$(providerId)).data.ownerUid == request.auth.uid;
    }

    function isSupplierOwner(supplierId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.supplierId == supplierId
        && firestore.exists(/databases/(default)/documents/suppliers/$(supplierId))
        && firestore.get(/databases/(default)/documents/suppliers/$(supplierId)).data.ownerUid == request.auth.uid;
    }

    // Product photos + marketing banners (admin/products, admin/ads)
    match /products/{productId}/{fileName} {
      // Anyone can view product images on the storefront
      allow read: if true;

      // Only admins can upload, replace, or delete product images
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Service provider logos / profile photos
    match /providers/{providerId}/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || isProviderOwner(providerId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Supplier logos
    match /suppliers/{supplierId}/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || isSupplierOwner(supplierId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Marketing banner images uploaded from /admin/ads
    match /ads/{adId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Block everything else by default (implicit deny)
  }
}
