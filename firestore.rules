rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'admin';
    }

    function isSupplierUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'supplier';
    }

    function supplierDoc(supplierId) {
      return get(/databases/$(database)/documents/suppliers/$(supplierId));
    }

    function ownsSupplier(supplierId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/suppliers/$(supplierId))
        && supplierDoc(supplierId).data.ownerUid == request.auth.uid;
    }

    function linkedSupplierId() {
      return userDoc().data.supplierId;
    }

    function canWriteCatalogFor(supplierId) {
      return isAdmin()
        || (
          isSupplierUser()
          && linkedSupplierId() == supplierId
          && ownsSupplier(supplierId)
        );
    }

    function isGuestCustomer(customerId) {
      return customerId is string && customerId.matches('guest.*');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if canWriteCatalogFor(request.resource.data.supplierId);
      allow update, delete: if canWriteCatalogFor(resource.data.supplierId)
        && (
          isAdmin()
          || request.resource.data.supplierId == resource.data.supplierId
        );
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.userId == null
        || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create: if canWriteCatalogFor(request.resource.data.supplierId)
        || (
          // Legacy open create for seed/bootstrap without supplierId
          !exists(/databases/$(database)/documents/packages/$(packageId))
          && !('supplierId' in request.resource.data)
        );
      allow update, delete: if canWriteCatalogFor(resource.data.supplierId)
        && (
          isAdmin()
          || request.resource.data.supplierId == resource.data.supplierId
        );
    }

    match /bulkOrders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() || isGuestCustomer(request.resource.data.customerId);
      allow update: if isAdmin();
    }

    match /wholesaleAccounts/{accountId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() || isGuestCustomer(request.resource.data.customerId);
      allow update: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/settings/$(docId));
      allow update: if isAdmin();
    }

    match /marketingAds/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.approvalStatus == 'pending'
          && request.resource.data.isDefault == false
        );

      allow update: if isAdmin()
        || (
          ownsSupplier(supplierId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.isDefault == resource.data.isDefault
        );

      allow delete: if isAdmin();
    }

    // Token in the URL is the secret; rules limit what clients can change.
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /serviceProviders/{providerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'updatedAt'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingCount', 'updatedAt']);
    }

    match /providerAvailability/{availabilityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /serviceBookings/{bookingId} {
      // Confirmation pages load by opaque booking id; list stays restricted.
      allow get: if true;
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (
          resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'paytotaPurchaseId', 'paytotaReference', 'status', 'updatedAt'])
        );
    }

    match /serviceReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /sharedCheckouts/{token} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update: if resource.data.status == 'pending'
        && (
          (request.resource.data.status == 'pending'
            && resource.data.get('orderId', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderId']))
          || (request.resource.data.status == 'paid'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderId', 'paidAt']))
        );
    }

    match /sharedBookings/{token} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.bookingId is string;
      allow update: if resource.data.status == 'pending'
        && request.resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'bookingId', 'paidAt']);
    }
  }
}
